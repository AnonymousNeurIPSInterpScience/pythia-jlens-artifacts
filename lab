#!/usr/bin/env bash
# lab — one entry point for the whole repo. Provision, run, watch, pull, tear down.
#
#   ./lab                     the map: what exists, what is running, what it costs
#   ./lab help                every subcommand
#
# Everything here delegates to repro/*.sh, which stay independently runnable. This file
# adds the two things a pile of scripts cannot: a fleet (N boxes provisioned in parallel,
# addressed as one) and tmux (jobs that survive your laptop closing, and a live dashboard).
#
# Design rules:
#   - never destroy without a verified pull receipt
#   - never spend without printing the price first
#   - every remote job runs inside a named remote tmux session, so nothing dies on hangup

set -euo pipefail
LAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$LAB_ROOT/repro/lib/common.sh"

FLEET_FILE="$REPO_ROOT/.fleet"          # one "alias<TAB>instance_id" per line
LOCAL_SESSION="lab"                      # local tmux session for the dashboard
REMOTE_SESSION="train"                   # remote tmux session; durable across ssh drops

fleet_aliases() { [ -f "$FLEET_FILE" ] && cut -f1 "$FLEET_FILE" || true; }
fleet_id()      { [ -f "$FLEET_FILE" ] && awk -v a="$1" '$1==a{print $2}' "$FLEET_FILE" || true; }
fleet_add()     { mkdir -p "$(dirname "$FLEET_FILE")"; printf "%s\t%s\n" "$1" "$2" >> "$FLEET_FILE"; }
fleet_rm()      { [ -f "$FLEET_FILE" ] && grep -v "^$1	" "$FLEET_FILE" > "$FLEET_FILE.tmp" 2>/dev/null; mv -f "$FLEET_FILE.tmp" "$FLEET_FILE" 2>/dev/null || true; }

# ============================================================ help
cmd_help() {
cat <<'EOF'
  lab — the control surface for this repo

  GETTING SET UP                                              cost
    ./lab doctor                  what you must configure     free
    ./lab setup                   build .venv + vendor jlens  free
    ./lab fetch                   artifacts from HF (required) ~50 MB
    ./lab fetch --all             every lens + corpus pool     ~3 GB
    ./lab results                 results JSON from the mirror ~8 MB
    ./lab verify                  TIER 0 gate, run it always  free

  BEFORE SPENDING
    ./lab cost <model> <n> [gpu]  price one fit               free
    ./lab cost --table            every model, every GPU      free
    ./lab cost --experiment e28   a named experiment          free
    ./lab offers [gpu] [n] [max$] live offers, best-value first

  THE FLEET
    ./lab up <n> [gpu] [max$]     rent n boxes, in parallel   $$$
    ./lab push [alias]            rsync code to a box (or all)
    ./lab preflight [alias]       on-box gate; do not skip
    ./lab run <alias> <cmd>       launch in a durable remote tmux
    ./lab shard <file>            one line = one job, spread over the fleet
    ./lab status                  boxes, GPU, progress, burn rate
    ./lab util [--watch N]        SM/HBM util vs roofline expectation; flags <80%
    ./lab watch                   tmux dashboard, one window per box
    ./lab logs <alias>            tail a box's job log
